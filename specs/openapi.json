                }
              }
            }
          }
        },
        "tags": [
          "jobs"
        ],
        "operationId": "getJobsId"
      }
    },
    "/jobs": {
      "get": {
        "description": "Provides access to all publicly visible jobs for the owner's account",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "description": "Page of results to fetch.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "description": "Number of results to return per page.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "in": "query",
            "name": "search",
            "description": "Search on name or description.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "postal_code",
            "description": "Search by Postal Code (uses postal_code_radius).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "postal_code_radius",
            "description": "Number of miles from postal_code.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "employment_id",
            "description": "Narrow by employment type.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "in": "query",
            "name": "location_id",
            "description": "Narrow by location.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "in": "query",
            "name": "department_id",
            "description": "Narrow by department.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "in": "query",
            "name": "brand_id",
            "description": "Narrow by brand.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "in": "query",
            "name": "aggregate",
            "description": "Show jobs from other accounts. This parameter is ignored unless your account has the ability/permission to access or other/related accounts.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "account_id",
            "description": "Search by account. This parameter is ignored unless your account has access to applicants from other/related accounts.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "in": "query",
            "name": "account_class_ids[]",
            "description": "Search for Jobs by account class. <br>This parameter is ignored unless your account has access to Jobs from other/related account classes.",
            "required": false,
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provides access to all publicly visible jobs for the owner's account",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "jobs"
        ],
        "operationId": "getJobs"
      }
    },
    "/apps": {
      "post": {
        "description": "Add a new applicant to a job",
