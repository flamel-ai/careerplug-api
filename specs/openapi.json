  "servers": [
    {
      "url": "https://api.careerplug.com",
      "description": "CareerPlug API (production)"
    }
  ],
  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "name": "access_token",
        "in": "query",
        "description": "OAuth 2.0 access token passed as a QUERY parameter (not an Authorization header). This is how CareerPlug's Grape/WineBouncer API expects credentials."
      },
      "oauth2": {
        "type": "oauth2",
        "description": "Tokens are minted on https://app.careerplug.com (the Rails/Doorkeeper host), NOT on the API host. Access tokens expire after 48 hours. client_credentials issues NO refresh token -- re-mint on expiry. authorization_code issues a refresh token, and its authorization code must be exchanged within 10 minutes.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://app.careerplug.com/oauth/token",
            "scopes": {
              "global_partner_api": "Global partner integration access."
            }
          },
          "authorizationCode": {
            "authorizationUrl": "https://app.careerplug.com/oauth/authorize",
            "tokenUrl": "https://app.careerplug.com/oauth/token",
            "refreshUrl": "https://app.careerplug.com/oauth/token",
            "scopes": {
              "global_partner_api": "Global partner integration access."
            }
          }
        }
      }
    },
    "schemas": {
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Unique identifier"
          },
          "name": {
            "type": "string",
            "description": "Job name"
          },
          "description": {
            "type": "string",
            "description": "Job description"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "inactive",
              "passive",
              "incompatible",
              "waiting",
              "rejected"
            ],
            "description": "Current status"
          },
          "city": {
            "type": "string",
            "description": "City"
          },
          "state": {
            "type": "string",
            "description": "State/Province"
          },
          "postal_code": {
            "type": "string",
            "description": "ZIP/Postal Code"
          },
          "country": {
            "type": "string",
            "description": "Country"
          },
          "employment": {
